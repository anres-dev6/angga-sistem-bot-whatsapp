{
    "watch": [
        "commands",
        "handler",
        "utils",
        "index.js",
        "config.js",
        ".restart-trigger",
        ".env"
    ],
    "ext": "js,json",
    "ignore": [
        "node_modules",
        "auth",
        "sessions",
        "logs",
        "data/owners.json"
    ],
    "delay": 1000,
    "verbose": true,
    "restartable": "rs"
}